# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the client. Needed by the seed script and by
# the MCP endpoint (/api/mcp), which scopes every query to the token owner.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The first user signing up with this email becomes an admin
INITIAL_ADMIN_EMAIL=you@example.com

# Set to "true" once Google OAuth is configured in Supabase (see README)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Optional: public base URL used in links returned by the MCP server
# NEXT_PUBLIC_APP_URL=https://drawme.example.com
